{
  "name": "nodewarden",
  "version": "1.8.0",
  "description": "Minimal Bitwarden-compatible server running on Cloudflare Workers",
  "author": "shuaiplus",
  "license": "LGPL-3.0",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev -c wrangler.toml",
    "dev:kv": "wrangler dev -c wrangler.kv.toml",
    "dev:demo": "vite --config webapp/vite.config.ts --mode demo --host 127.0.0.1 --port 5174",
    "build": "vite build --config webapp/vite.config.ts",
    "build:demo": "vite build --config webapp/vite.config.ts --mode demo && node scripts/pages-spa-redirects.cjs",
    "domains:sync": "node scripts/sync-global-domains.mjs",
    "i18n": "node scripts/i18n-validate.cjs",
    "i18n:validate": "node scripts/i18n-validate.cjs",
    "test:config-compatibility": "tsx --test scripts/config-compatibility.test.ts",
    "test:web-crypto": "tsx --test scripts/web-crypto-availability.test.ts",
    "test:webauthn-mobile": "node --test scripts/webauthn-mobile-connector.test.mjs",
    "test:webauthn-connector": "node --test scripts/webauthn-connector.test.mjs && tsx --test scripts/webauthn-connector-headers.test.ts",
    "test:webauthn-connectors": "node --test scripts/webauthn-mobile-connector.test.mjs scripts/webauthn-connector.test.mjs && tsx --test scripts/webauthn-connector-headers.test.ts",
    "db:generate": "drizzle-kit generate && node scripts/embed-baseline.mjs",
    "db:embed": "node scripts/embed-baseline.mjs",
    "db:seed": "tsx scripts/seed.ts",
    "test:db-schema": "tsx --test scripts/relations-smoke.test.ts scripts/drizzle-migrate.test.ts",
    "test:auth-password": "tsx --test src/services/auth-password.test.ts",
    "test:org-authz": "tsx --test src/services/org-authz.test.ts",
    "test:register-payload": "tsx --test src/services/register-payload.test.ts",
    "test:enterprise-license": "tsx --test src/services/enterprise-license.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:official": "playwright test e2e/official-web.spec.ts",
    "build:official-web": "node scripts/build-official-web.mjs",
    "dev:official-web": "node scripts/serve-official-web.mjs",
    "deploy": "wrangler deploy",
    "deploy:kv": "node scripts/ensure-kv.cjs && wrangler deploy -c wrangler.kv.toml",
    "deploy:demo": "npm run build:demo && wrangler pages deploy dist --project-name nw-demo",
    "deploy:official-web": "npm run build:official-web && wrangler pages deploy dist --project-name nodewarden-official-web --config official-web/wrangler.toml"
  },
  "keywords": [
    "bitwarden",
    "vaultwarden",
    "cloudflare",
    "workers",
    "password-manager"
  ],
  "cloudflare": {
    "bindings": {
      "JWT_SECRET": {
        "description": "Use a strong random string (32+ characters recommended)"
      },
      "DB": {
        "description": "D1 database for storing vault data"
      },
      "ATTACHMENTS": {
        "description": "R2 bucket for storing file attachments"
      },
      "ATTACHMENTS_KV": {
        "description": "Optional KV namespace fallback for attachment/send-file storage"
      }
    }
  },
  "overrides": {
    "nanoid": "3.3.17",
    "undici": "8.9.0",
    "@babel/core": ">=7.29.6",
    "esbuild": ">=0.28.1",
    "ws": "8.21.0",
    "sharp": "0.35.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260630.1",
    "@playwright/test": "^1.55.0",
    "@preact/preset-vite": "^2.10.5",
    "@types/node": "^26.0.1",
    "autoprefixer": "^10.5.2",
    "better-sqlite3": "13.0.3",
    "drizzle-kit": "1.0.0-rc.4",
    "drizzle-seed": "1.0.0-rc.4",
    "opencc-js": "^1.3.2",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "wrangler": "^4.105.0"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.27",
    "@better-auth/sso": "^1.6.27",
    "@noble/hashes": "^2.2.0",
    "@simplewebauthn/server": "^13.3.2",
    "@tanstack/react-query": "^5.101.2",
    "@zip.js/zip.js": "^2.8.26",
    "better-auth": "^1.6.27",
    "drizzle-orm": "1.0.0-rc.4",
    "fflate": "^0.8.3",
    "jsqr": "1.4.0",
    "lucide-preact": "^1.22.0",
    "preact": "^10.29.3",
    "qrcode-generator": "^2.0.4",
    "wouter": "^3.10.0"
  }
}
