{
  "name": "nodewarden",
  "version": "1.8.0",
  "description": "Minimal Bitwarden-compatible server running on Cloudflare Workers",
  "author": "shuaiplus",
  "license": "LGPL-3.0",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev -c wrangler.toml",
    "dev:kv": "wrangler dev -c wrangler.kv.toml",
    "domains:sync": "node scripts/sync-global-domains.mjs",
    "test": "tsx --test 'src/**/*.test.ts' 'src/**/*.test.mjs'",
    "lint": "eslint src scripts e2e shared admin eslint.config.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate && node scripts/embed-baseline.mjs",
    "db:embed": "node scripts/embed-baseline.mjs",
    "db:seed": "tsx scripts/seed.ts",
    "test:e2e": "playwright test",
    "test:e2e:official": "playwright test e2e/official-web.spec.ts e2e/official-org-create.spec.ts e2e/official-org-reporting.spec.ts",
    "build:official-web": "node scripts/build-official-web.mjs",
    "build:assets": "node scripts/build-worker-assets.mjs",
    "deploy": "wrangler deploy",
    "deploy:kv": "node scripts/ensure-kv.cjs && wrangler deploy -c wrangler.kv.toml",
    "test:e2e:sm-clients": "node scripts/sm-client-e2e.mjs",
    "build:admin": "cd admin && vite build",
    "pretest": "npm run build:admin",
    "check:admin": "cd admin && svelte-kit sync && svelte-check --fail-on-warnings"
  },
  "keywords": [
    "bitwarden",
    "vaultwarden",
    "cloudflare",
    "workers",
    "password-manager"
  ],
  "cloudflare": {
    "bindings": {
      "JWT_SECRET": {
        "description": "Use a strong random string (32+ characters recommended)"
      },
      "DB": {
        "description": "D1 database for storing vault data"
      },
      "ATTACHMENTS": {
        "description": "R2 bucket for storing file attachments"
      },
      "ATTACHMENTS_KV": {
        "description": "Optional KV namespace fallback for attachment/send-file storage"
      }
    }
  },
  "overrides": {
    "nanoid": "3.3.18",
    "undici": "8.9.0",
    "@babel/core": ">=7.29.6",
    "esbuild": ">=0.28.1",
    "ws": "8.21.0",
    "sharp": "0.35.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260630.1",
    "@playwright/test": "^1.55.0",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.0.1",
    "better-sqlite3": "13.0.3",
    "drizzle-kit": "1.0.0-rc.4",
    "drizzle-seed": "1.0.0-rc.4",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-svelte": "^3.23.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "^1.8.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "wrangler": "^4.105.0"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.27",
    "@better-auth/sso": "^1.6.27",
    "@noble/hashes": "^2.2.0",
    "@simplewebauthn/server": "^13.3.2",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.6.27",
    "drizzle-orm": "1.0.0-rc.4",
    "fflate": "^0.8.3",
    "hono": "^4.13.9",
    "otpauth": "^9.5.2",
    "zod": "^4.6.5"
  }
}
